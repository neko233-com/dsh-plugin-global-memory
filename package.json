{
  "name": "@neko233/dsh-plugin-global-memory",
  "version": "0.4.0",
  "description": "Persistent memory for DSH: global personal assets plus project-scoped facts, secure credentials, health progress bars, agent tools, import/export, and Git sync.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neko233-com/dsh-plugin-global-memory.git"
  },
  "homepage": "https://github.com/neko233-com/dsh-plugin-global-memory#readme",
  "bugs": {
    "url": "https://github.com/neko233-com/dsh-plugin-global-memory/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "global-memory",
    "project-memory",
    "credentials",
    "git"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
